{
  "name": "@syllables-dev/parse",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ttml": {
      "types": "./dist/formats/ttml/index.d.ts",
      "import": "./dist/formats/ttml/index.js"
    },
    "./lrc": {
      "types": "./dist/formats/lrc.d.ts",
      "import": "./dist/formats/lrc.js"
    },
    "./eslrc": {
      "types": "./dist/formats/eslrc.d.ts",
      "import": "./dist/formats/eslrc.js"
    },
    "./qrc": {
      "types": "./dist/formats/qrc.d.ts",
      "import": "./dist/formats/qrc.js"
    },
    "./yrc": {
      "types": "./dist/formats/yrc.d.ts",
      "import": "./dist/formats/yrc.js"
    },
    "./lys": {
      "types": "./dist/formats/lys/index.d.ts",
      "import": "./dist/formats/lys/index.js"
    },
    "./lqe": {
      "types": "./dist/formats/lqe.d.ts",
      "import": "./dist/formats/lqe.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "bun build src/index.ts src/formats/ttml/index.ts src/formats/lrc.ts src/formats/eslrc.ts src/formats/qrc.ts src/formats/yrc.ts src/formats/lys/index.ts src/formats/lqe.ts --outdir dist --target browser --format esm --minify && tsgo -p tsconfig.build.json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "tsgo": "tsgo --noEmit"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "ultracite": "7.10.2"
  }
}
